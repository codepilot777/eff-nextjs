# Turso/libSQL — leave unset for local dev to fall back to a local SQLite file (eff_database.db)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Shared password gate for the Instructor console (/instructor, /instructor/ios)
# and instructor-only API actions (publish/activate flight, delete flight, SimBrief import).
INSTRUCTOR_PASSWORD=

# Gemini API key used by /api/ai for NOTAM/METAR-TAF text generation
GEMINI_API_KEY=
